# PostgreSQL (docker compose maps to host port 5434)
DATABASE_URL="postgresql://carebridge:carebridge_dev@localhost:5434/carebridge?schema=public"

# Auth — generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# HTTP
PORT=4000
CORS_ORIGINS="http://localhost:3000"
# Set to true when running behind a reverse proxy (correct client IPs for rate limiting)
TRUST_PROXY=false

# AI (server-side only; never exposed to the web app).
# Leave GEMINI_API_KEY empty to run with the deterministic rule engines only.
GEMINI_API_KEY=
# Verify availability for your key: GET https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary model is out of quota, overloaded or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
AI_TIMEOUT_MS=45000
