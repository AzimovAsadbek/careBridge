# PostgreSQL (docker compose maps to host port 5434)
DATABASE_URL="postgresql://carebridge:carebridge_dev@localhost:5434/carebridge?schema=public"

# Auth — generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# HTTP
PORT=4000
CORS_ORIGINS="http://localhost:3000"

# Optional LLM for AI features. Leave empty to use the built-in rule engine.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-4-5-20251001"
AI_TIMEOUT_MS=8000
