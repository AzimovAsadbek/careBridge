generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
}

enum FacilityType {
  HOSPITAL
  FAMILY_CLINIC
  RURAL_POST
}

enum Sex {
  MALE
  FEMALE
}

enum PatientStatus {
  ADMITTED
  DISCHARGED
  IN_FOLLOW_UP
  STABLE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ReferralStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum FollowUpStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum GeneralCondition {
  GOOD
  FAIR
  POOR
  CRITICAL
}

/// Which engine produced the stored result (see ai/risk.safety.ts).
enum AiEngine {
  /// Deterministic rules only (no AI provider configured).
  RULE_ENGINE
  /// Gemini result accepted (at or above the rule-based risk).
  GEMINI
  /// Gemini suggested a lower risk; the safety rules kept the higher level.
  GEMINI_WITH_RULE_OVERRIDE
  /// AI configured but unavailable (timeout, quota, malformed output) — rules used.
  FALLBACK_RULE_ENGINE
}

enum FeedbackType {
  COMPLAINT
  SUGGESTION
  PRAISE
  OTHER
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model Facility {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  type       FacilityType
  district   String
  /// Short, non-guessable code printed in QR codes. Never expose the UUID publicly.
  publicCode String       @unique
  createdAt  DateTime     @default(now())

  users             User[]
  patients          Patient[]
  referralsOut      Referral[] @relation("ReferralFrom")
  referralsIn       Referral[] @relation("ReferralTo")
  feedback          Feedback[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  facilityId   String   @db.Uuid
  facility     Facility @relation(fields: [facilityId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientsAsDoctor  Patient[]     @relation("FamilyDoctor")
  referralsAssigned Referral[]    @relation("ReferralDoctor")
  followUpsAssigned FollowUp[]    @relation("FollowUpNurse")
  observations      Observation[]
  auditLogs         AuditLog[]

  @@index([facilityId, role])
}

model Patient {
  id             String        @id @default(uuid()) @db.Uuid
  fullName       String
  birthDate      DateTime      @db.Date
  sex            Sex
  phone          String?
  address        String
  district       String
  diagnosisNote  String?
  status         PatientStatus @default(ADMITTED)
  riskLevel      Priority?
  facilityId     String        @db.Uuid
  facility       Facility      @relation(fields: [facilityId], references: [id])
  familyDoctorId String?       @db.Uuid
  familyDoctor   User?         @relation("FamilyDoctor", fields: [familyDoctorId], references: [id])
  admittedAt     DateTime?
  dischargedAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  observations    Observation[]
  referrals       Referral[]
  followUps       FollowUp[]
  riskAssessments RiskAssessment[]

  @@index([facilityId, status])
  @@index([familyDoctorId])
  @@index([fullName])
}

model Referral {
  id               String         @id @default(uuid()) @db.Uuid
  patientId        String         @db.Uuid
  patient          Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fromFacilityId   String         @db.Uuid
  fromFacility     Facility       @relation("ReferralFrom", fields: [fromFacilityId], references: [id])
  toFacilityId     String         @db.Uuid
  toFacility       Facility       @relation("ReferralTo", fields: [toFacilityId], references: [id])
  assignedDoctorId String?        @db.Uuid
  assignedDoctor   User?          @relation("ReferralDoctor", fields: [assignedDoctorId], references: [id])
  priority         Priority
  reason           String
  dischargeSummary String?
  status           ReferralStatus @default(PENDING)
  deadline         DateTime
  acceptedAt       DateTime?
  completedAt      DateTime?
  /// First time the referral was flagged overdue (escalation to admin).
  escalatedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  followUps FollowUp[]

  @@index([status, deadline])
  @@index([assignedDoctorId, status])
  @@index([toFacilityId, status])
  @@index([patientId])
}

model FollowUp {
  id                String         @id @default(uuid()) @db.Uuid
  referralId        String         @db.Uuid
  referral          Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)
  patientId         String         @db.Uuid
  patient           Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assignedNurseId   String?        @db.Uuid
  assignedNurse     User?          @relation("FollowUpNurse", fields: [assignedNurseId], references: [id])
  status            FollowUpStatus @default(SCHEDULED)
  scheduledFor      DateTime?
  visitStartedAt    DateTime?
  completedAt       DateTime?
  outcome           String?
  /// Set when any part of this visit was captured offline and synced later.
  syncedFromOffline Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  observations Observation[]

  @@index([assignedNurseId, status])
  @@index([referralId])
}

model Observation {
  id               String            @id @default(uuid()) @db.Uuid
  /// Client-generated id — makes offline sync idempotent.
  clientId         String?           @unique
  patientId        String            @db.Uuid
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  followUpId       String?           @db.Uuid
  followUp         FollowUp?         @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  recordedById     String            @db.Uuid
  recordedBy       User              @relation(fields: [recordedById], references: [id])
  systolic         Int?
  diastolic        Int?
  pulse            Int?
  temperature      Float?
  spo2             Int?
  symptoms         String[]
  generalCondition GeneralCondition?
  notes            String?
  recordedAt       DateTime
  syncedFromOffline Boolean          @default(false)
  createdAt        DateTime          @default(now())

  riskAssessments RiskAssessment[]

  @@index([patientId, recordedAt])
}

model RiskAssessment {
  id                String       @id @default(uuid()) @db.Uuid
  patientId         String       @db.Uuid
  patient           Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  observationId     String?      @db.Uuid
  observation       Observation? @relation(fields: [observationId], references: [id], onDelete: SetNull)
  level             Priority
  score             Int
  factors           Json
  recommendedAction String
  engine            AiEngine
  /// Model self-reported confidence 0–1 (AI results only).
  confidence        Float?
  warnings          String[]     @default([])
  provider          String?
  model             String?
  /// True while the rule-based result is shown and the AI review is still running.
  aiPending         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  @@index([patientId, createdAt])
  @@index([aiPending])
  @@index([level, createdAt])
}

/// Anonymous by design: no patient, user, IP or device link.
model Feedback {
  id         String       @id @default(uuid()) @db.Uuid
  facilityId String       @db.Uuid
  facility   Facility     @relation(fields: [facilityId], references: [id])
  ward       String?
  rating     Int
  type       FeedbackType
  text       String?
  createdAt  DateTime     @default(now())

  analysis FeedbackAnalysis?

  @@index([facilityId, createdAt])
}

model FeedbackAnalysis {
  id         String    @id @default(uuid()) @db.Uuid
  feedbackId String    @unique @db.Uuid
  feedback   Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  sentiment  Sentiment
  category   String
  topics     String[]
  priority   Priority
  /// Patient-safety / integrity concern (bribery, abuse, negligence, threats, emergencies). Always HIGH priority.
  safetySignal Boolean  @default(false)
  summary    String?
  engine     AiEngine
  warnings   String[]  @default([])
  provider   String?
  model      String?
  aiPending  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([sentiment])
  @@index([aiPending])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
